import google.generativeai as genai
from google.colab import userdata
from langchain_chroma import Chroma
from langchain_huggingface import HuggingFaceEmbeddings
import os

# 1. Re-configure the Gemini API
api_key = userdata.get("GEMINI_API_KEY")
genai.configure(api_key=api_key)

# Switching to a confirmed available model name from the previous list
target_model = "models/gemini-flash-latest"

# 2. Re-initialize the vector store linkage
persist_directory = "./chroma_db_local"
embedding_model = HuggingFaceEmbeddings(model_name="sentence-transformers/all-MiniLM-L6-v2")

vector_store = Chroma(
    collection_name="research_collection",
    embedding_function=embedding_model,
    persist_directory=persist_directory
)

def retrieve_context(query: str, k: int = 3):
    retrieved_docs = vector_store.similarity_search(query, k=k)
    docs_content = ""
    for doc in retrieved_docs:
        source = doc.metadata.get("source", "Unknown")
        docs_content += f"Source: {source}\nContent: {doc.page_content}\n\n"
    return docs_content, retrieved_docs

def docu_chat(user_query):
    context, source_docs = retrieve_context(user_query, k=3)
    prompt = f"You are a professional veterinary and agricultural assistant.\nUse the following pieces of retrieved context to answer the question.\n\nContext: {context}\n\nQuestion: {user_query}"
    model = genai.GenerativeModel(target_model)
    response = model.generate_content(prompt)
    return {"answer": response.text, "source_documents": source_docs}

import shutil
import os
from langchain_chroma import Chroma

persist_directory = './chroma_db_local'
collection_name = 'research_collection'

if os.path.exists(persist_directory):
    shutil.rmtree(persist_directory)
os.makedirs(persist_directory, exist_ok=True)

print('Building local vector store...')
if 'all_splits' in globals() and all_splits:
    vector_store = Chroma.from_documents(
        documents=all_splits[:500],
        embedding=embedding_model,
        persist_directory=persist_directory,
        collection_name=collection_name
    )
    print('Vector store is ready.')
else:
    print('Error: splits not found. Check the document loading cell.')

# Re-execute the final query with the confirmed model identifier
query = "Explain what is the use of livestock based on the documents?"
try:
    result = docu_chat(query)
    print(f"\nQUESTION: {query}")
    print(f"\nANSWER: {result['answer']}")
except Exception as e:
    print(f"Execution failed: {e}")