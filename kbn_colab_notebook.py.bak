def retrieve_context(query: str, k: int = 2):
  retrieved_docs = vector_store.similarity_search(query, k=k)

  docs_content = ""
  for doc in retrieved_docs:
    docs_content += f"Source: {doc.metadata.get('source', 'N/A')}\n"
    docs_content += f"Content: {doc.page_content}\n\n"

  print("--- Retrieved Context ---")
  print(docs_content)
  print("--- Source Documents ---")
  for doc in retrieved_docs:
    print(f"Source: {doc.metadata.get('source', 'N/A')} - Page: {doc.metadata.get('page_label', doc.metadata.get('page', 'N/A'))}")

  return docs_content, retrieved_docs

